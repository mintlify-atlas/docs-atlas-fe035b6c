  "keyFeatures": [
    "Declarative Istio control plane management via Kubernetes custom resources",
    "Support for both sidecar and ambient mesh deployment modes",
    "Flexible update strategies: InPlace and RevisionBased upgrades",
    "Multi-version support with n-2 Istio release compatibility",
    "Multi-cluster and multi-mesh deployment capabilities",
    "Native OpenShift integration with CNI plugin management",
    "Automated workload migration during upgrades",
    "Helm-based configuration with profile support"
  ],
  "publicApiSurface": [
    "Istio (v1) - Main control plane resource",
    "IstioRevision (v1) - Specific control plane revision",
    "IstioRevisionTag (v1) - Revision tag for workload routing",
    "IstioCNI (v1) - CNI plugin configuration",
    "ZTunnel (v1) - Ambient mode tunnel component",
    "Helm chart: sail-operator",
    "make install - Install CRDs",
    "make deploy - Deploy operator",
    "kubectl apply -f samples/istio-sample.yaml - Deploy control plane"
  ]
